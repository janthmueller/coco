# Generated by coco shell init. Add the initialization command to config.fish.
function coco --description 'CoCo with workspace directory navigation'
    set -l _coco_prefix
    set -l _coco_scoped 0
    for _coco_arg in $argv
        switch $_coco_arg
            case cd
                set -l _coco_remaining $argv
                set -e _coco_remaining[1..(math (count $_coco_prefix) + 1)]
                for _coco_arg in $_coco_remaining
                    if contains -- $_coco_arg -h --help
                        command coco $_coco_prefix cd $_coco_remaining
                        return $status
                    end
                end
                set -l _coco_destination (command coco $_coco_prefix path $_coco_remaining)
                set -l _coco_result $status
                if test $_coco_result -ne 0
                    return $_coco_result
                end
                if test (count $_coco_destination) -ne 1; or test -z "$_coco_destination"
                    printf '%s\n' 'coco: no workspace path was returned' >&2
                    return 1
                end
                cd -- "$_coco_destination"
                return $status
            case @COMMANDS@
                break
            case -a --all-repos -g --global --no-input
            case '-*'
                break
            case '*'
                if test $_coco_scoped -eq 1
                    break
                end
                set _coco_scoped 1
        end
        set -a _coco_prefix "$_coco_arg"
    end
    command coco $argv
end
